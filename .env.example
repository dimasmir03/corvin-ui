HTTP_ADDR=127.0.0.1:8080
AUTH_MODE=none
ONLINE_COLLECT_INTERVAL=30s

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=corvinvpn
DB_PASSWORD=change-me-db-password
DB_NAME=corvinvpn
DB_SSLMODE=disable

RABBITMQ_USER=corvinvpn
RABBITMQ_PASSWORD=change-me-rabbitmq-password
RABBITMQ_URL=amqps://corvinvpn:change-me-rabbitmq-password@127.0.0.1:1765/
RABBITMQ_CONTAINER_URL=amqps://corvinvpn:change-me-rabbitmq-password@rabbitmq:5671/
AMQP_EXCHANGE_COMPLAINTS=vpn.complaints
AMQP_EXCHANGE_USERS=vpn.users
RABBITMQ_RESULT_QUEUE=corvin.job.results

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=corvinvpn
MINIO_SECRET_KEY=change-me-minio-secret-key
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_BUCKET=complaints

SESSION_SECRET=change-me-session-secret

CERT_FILE=/opt/corvin-ui/cert/cert.pem
KEY_FILE=/opt/corvin-ui/cert/key.pem
CA_FILE=/opt/corvin-ui/cert/ca.pem
BASE_URL=http://127.0.0.1:8080
CORVIN_UI_ENV_FILE=.env.example
